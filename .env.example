# URL pública canônica do portal (sem barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:8080

# Origem do Plone (server + rewrite /__plone__)
PLONE_ORIGIN=https://www3.ufac.br

# ISR: revalidação do cache público em dias (padrão: 1)
PLONE_REVALIDATE_DAYS=1

# Versão embutida no build (opcional em local — next.config resolve via git describe)
# Em CI/Docker estes valores são injetados automaticamente a cada commit.
# NEXT_PUBLIC_APP_VERSION=0.1.0
# NEXT_PUBLIC_GIT_SHA=abc1234
# NEXT_PUBLIC_BUILD_TIME=2026-08-20T18:00:00Z
